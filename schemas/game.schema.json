{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yoonwoojeong/Arcade/schemas/game.schema.json",
  "title": "Claude Arcade game manifest (SDK v1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "version",
    "sdk",
    "author",
    "description",
    "controls",
    "accessibility",
    "sessionLength"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,30}$",
      "description": "Must equal the game's folder name."
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 40 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "sdk": { "const": 1 },
    "author": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1, "maxLength": 140 },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyboard"],
      "properties": {
        "keyboard": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "touch": { "type": "string" }
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["screenReader", "reducedMotion", "colorIndependent"],
      "properties": {
        "screenReader": { "enum": ["full", "partial", "none"] },
        "reducedMotion": { "type": "boolean" },
        "colorIndependent": { "type": "boolean" }
      }
    },
    "sessionLength": { "enum": ["short", "medium", "untimed"] }
  }
}
